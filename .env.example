# Free key: https://api.data.gov/signup/   (covers the FBI Crime Data Explorer API)
FBI_CDE_API_KEY=
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Optional: override the CDE origin. The unkeyed mirror is the default because the
# keyed api.data.gov gateway is rate-limited per key (observed 10-1000 req/hr).
# NLEDP_CDE_ORIGIN=https://cde.ucr.cjis.gov/LATEST
